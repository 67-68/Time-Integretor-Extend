#!/bin/bash
# Warden launcher - generated by `repl-kit app init`.
#
# Regenerating this file is safe; editing it by hand is not, because `init`
# overwrites it.
#
# Why this file exists
# --------------------
# Finder and a .app bundle start processes with a minimal PATH
# (/usr/bin:/bin:/usr/sbin:/sbin).  A bare `python3` therefore resolves to a
# *different* interpreter than the one in your shell, and every dependency you
# installed for the project goes missing - the TUI then fails in ways that look
# random ("sometimes a command just does not work").
#
# So the interpreter is baked in at init time: this runs the exact python that
# ran `repl-kit app init`.  Override it at runtime with TUI_PYTHON=... if you
# know better than the baked value.
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
cd "$REPO" || exit 1

# Finder's PATH is nearly empty; restore the usual suspects.  Note that the
# interpreter below does NOT depend on this - only subprocesses do (node, git...).
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$HOME/.local/bin:$PATH"

PY="${TUI_PYTHON:-/Library/Developer/CommandLineTools/usr/bin/python3}"
if [ ! -x "$PY" ]; then
    cat >&2 <<EOF
✗ 解释器不存在：$PY

  这个路径是 \`repl-kit app init\` 烤进来的（当初跑 init 的那个 python）。
  它可能被删了、venv 被重建了，或者仓库被搬到了别的机器上。

  修法二选一：
    TUI_PYTHON=/path/to/python3 "$0"          # 临时换一个
    repl-kit app init ...                      # 用当前解释器重新烤一遍
EOF
    exit 2
fi

# --- dependency self-check -------------------------------------------------
# Runs before the TUI, so a missing module reports the *actual* interpreter
# path instead of a stack trace from inside a Dock-launched process.
MISSING="$("$PY" - <<'PYCHECK'
import importlib
missing = []
for name in (('rich', 'prompt_toolkit')):
    try:
        importlib.import_module(name)
    except Exception:
        missing.append(name)
print(" ".join(missing))
PYCHECK
)"
if [ -n "$MISSING" ]; then
    cat >&2 <<EOF
✗ $PY 缺依赖：$MISSING

  这个解释器是 init 时烤进来的，不是你现在 shell 里那个：
      烤进来的 : $PY
      你 shell : $(command -v python3 2>/dev/null || echo '(无)')

  装它：   $PY -m pip install $MISSING
  换它：   TUI_PYTHON=\$(command -v python3) "$0"
  重烤：   repl-kit app init --force ...
EOF
    exit 2
fi

# --- optional external commands -------------------------------------------
for want in node; do
    if ! command -v "$want" >/dev/null 2>&1; then
        echo "⚠ 没找到 $want - TUI 能起，但依赖它的功能会失败。" >&2
    fi
done

exec "$PY" warden.py "$@"
