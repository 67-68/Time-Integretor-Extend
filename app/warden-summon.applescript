-- warden-summon.applescript - the only implementation of "bring Warden to the front".
-- Generated by `repl-kit app init`.
--
-- Semantics: **find it and focus it, otherwise create it** - never a second window.
--
--   1. read the iTerm session id recorded in app/.warden-window
--   2. look for that id across every iTerm window -> tab -> session
--   3. found     -> activate iTerm + select that window/tab/session
--                   + optionally type "refresh" into it (the TUI treats it
--                   as if you typed it, which refreshes whatever it shows)
--   4. not found (first run / you closed the window / iTerm restarted) -> create a
--      new window running app/Warden.command and record the new id
--
-- Why record the id instead of matching the window title: the TUI rewrites its own
-- title, and titles are not unique.  A session id is a UUID handed out by iTerm.
-- Losing the marker file costs you one extra window, never a broken launch.
--
-- The target terminal is iTerm2.  Its scripting name is "iTerm" (CFBundleName is
-- "iTerm2", but the scripting dictionary registers as "iTerm").
--
-- Usage:
--   osascript app/warden-summon.applescript              # summon
--   osascript app/warden-summon.applescript --dry-run    # say what it would do, touch nothing
--   osascript app/warden-summon.applescript --new        # ignore the recorded window
--   osascript app/warden-summon.applescript --no-refresh # focus only
--   osascript app/warden-summon.applescript --log        # tail the log
--
-- Troubleshooting: every step appends a line to the log.  Start there.

property REPO_HINT : "/Users/a67_68/projects/ti_extend"    -- baked by `init`; falls back to `path to me`
property MARKER_NAME : ".warden-window"
property LOG_REL : "temp/warden-summon.log"


-- ---------------------------------------------------------------- entry points
-- Each one is wrapped in a try: failures must leave a trace (log + a
-- self-dismissing dialog), so "nothing happened" is never unexplainable.

on run argv
    try
        set opts to my parseArgs(argv)
        return my summon(opts)
    on error e number n
        return my fail(e, n)
    end try
end run

on reopen
    try
        return my summon(my optsDefault())
    on error e number n
        return my fail(e, n)
    end try
end reopen

-- Stay resident so the app keeps a Dock / Command-Tab identity.
on idle
    return 5
end idle

on quit
    continue quit
end quit


-- ---------------------------------------------------------------- arguments

on optsDefault()
    return {dryRun:false, forceNew:false, doRefresh:true, logOnly:false}
end optsDefault

on parseArgs(argv)
    set opts to my optsDefault()
    repeat with a in argv
        set flag to (a as text)
        if flag is "--dry-run" then
            set dryRun of opts to true
        else if flag is "--new" then
            set forceNew of opts to true
        else if flag is "--no-refresh" then
            set doRefresh of opts to false
        else if flag is "--log" then
            set logOnly of opts to true
        end if
    end repeat
    return opts
end parseArgs


-- ---------------------------------------------------------------- main flow

on summon(opts)
    set dryRun to dryRun of opts
    set forceNew to forceNew of opts
    set wantRefresh to doRefresh of opts

    set repo to my resolveRepo()
    set markerPath to repo & "/app/" & MARKER_NAME
    set cmd to "cd " & quoted form of repo & " && exec ./app/Warden.command"

    if logOnly of opts then
        try
            return (do shell script "cat " & quoted form of (repo & "/" & LOG_REL) & " 2>/dev/null || true")
        on error
            return "(cannot read the log)"
        end try
    end if

    my logLine("")
    my logLine("=== summon  dry-run=" & dryRun & " forceNew=" & forceNew & " refresh=" & wantRefresh)

    set priorId to my readMarker(markerPath)
    my logLine("repo=" & repo & "  marker=" & markerPath & "  priorId=" & priorId)

    -- A dry run must not launch iTerm, so ask "is the GUI up?" instead of telling it.
    -- Pitfall: `application "iTerm" is running` returns true while iTerm's XPC
    -- daemon is alive even though the GUI is not (seen on 3.6.11).  Checking the
    -- main executable name needs no permission and is accurate.
    set guiUp to my isTerminalGuiRunning()
    my logLine("terminal GUI running = " & guiUp)

    if guiUp is false then
        if dryRun then
            return "terminal not running -> would create a window running: " & cmd
        end if
        return my spawnWindow(cmd, markerPath)
    end if

    -- Look for the previously recorded session.
    set hitW to 0
    set hitT to 0
    set hitS to 0
    set hitId to ""
    if (not forceNew) and (priorId is not "") then
        -- Wrapped in try: iTerm may not be fully ready right after launch and
        -- `count` raises -1708 (errAENoSuchObject).  Degrade to "no hit" instead
        -- of failing the whole summon.
        try
            tell application "iTerm"
                repeat with wi from 1 to (count of windows)
                    set w to window wi
                    repeat with ti from 1 to (count of tabs of w)
                        set t to tab ti of w
                        repeat with si from 1 to (count of sessions of t)
                            set s to session si of t
                            if (id of s) is priorId then
                                set hitW to wi
                                set hitT to ti
                                set hitS to si
                                set hitId to (id of s)
                            end if
                        end repeat
                    end repeat
                end repeat
            end tell
        on error e number n
            my logLine("window search failed (treating as no hit) " & n & ": " & e)
        end try
    end if
    my logLine("hit = " & hitId & "  (window " & hitW & " tab " & hitT & ")")

    if dryRun then
        if hitId is not "" then
            set tail to "focus only"
            if wantRefresh then set tail to "focus + refresh"
            return "hit session " & hitId & " (window " & hitW & " / tab " & hitT & ") -> " & tail
        end if
        if forceNew then
            return "--new: ignoring the marker (old id=" & priorId & ") -> would create a window running: " & cmd
        end if
        return "no hit (marker id=" & priorId & ") -> would create a window running: " & cmd
    end if

    if hitId is not "" then
        my focusSession(hitW, hitT, hitS)
        my logLine("focused " & hitId)
        if wantRefresh and "refresh" is not "" then
            -- Writing text is exactly what typing does, so the TUI runs it as a
            -- normal command.  Not fatal if it fails (the numbers just stay stale).
            try
                tell application "iTerm"
                    tell session hitS of tab hitT of window hitW to write text "refresh"
                end tell
                my logLine("refresh sent")
            on error e number n
                my logLine("refresh failed " & n & ": " & e)
            end try
        end if
        return "focused " & hitId
    end if

    return my spawnWindow(cmd, markerPath)
end summon


-- Bring that session to the front: activate the terminal, then select downwards.
-- Three separate try blocks: `select` support varies between iTerm versions, and
-- any one failure must not take "at least put the terminal in front" down with it.
on focusSession(hitW, hitT, hitS)
    tell application "iTerm"
        activate
        my logLine("  terminal activated")
        -- Pitfall: `set current window to window N` makes iTerm 3.6.11 raise
        -- -10000 (event handler failed).  The `select` command, applied level by
        -- level, is what actually works.
        try
            select (window hitW)
            my logLine("  select window " & hitW & " ok")
        on error e number n
            my logLine("  select window failed " & n & ": " & e)
        end try
        try
            select (tab hitT of window hitW)
            my logLine("  select tab " & hitT & " ok")
        on error e number n
            my logLine("  select tab failed " & n & ": " & e)
        end try
        try
            select (session hitS of tab hitT of window hitW)
            my logLine("  select session " & hitS & " ok")
        on error e number n
            my logLine("  select session failed " & n & ": " & e)
        end try
    end tell
end focusSession


on spawnWindow(cmd, markerPath)
    my logLine("spawnWindow: " & cmd)
    set newId to ""
    tell application "iTerm"
        activate
        my logLine("  terminal activated")
        create window with default profile
        my logLine("  window created")
        -- Right after create the shell may not be attached yet; writing then
        -- loses the text.  0.5s is a conservative cold-start figure, paid once.
        delay 0.5
        tell current session of current window
            write text cmd
        end tell
        set newId to (id of current session of current window)
    end tell
    my logLine("  new session id = " & newId)
    my writeMarker(markerPath, newId)
    return "created " & newId
end spawnWindow


on fail(e, n)
    my logLine("!! FAILED " & n & ": " & e)
    set hint to ""
    if n is -1743 then
        -- The one thing that needs a human click: macOS will not let one app
        -- control another silently.
        set hint to "
The 'control the terminal' automation permission was not granted.

  1. System Settings -> Privacy & Security -> Automation ->
     allow Warden to control iTerm2
  2. or:  tccutil reset AppleEvents com.ti-extend.warden
     then summon again and click Allow in the dialog (it waits 2 minutes)"
    end if
    if n is -1743 then
        try
            do shell script "open 'x-apple.systempreferences:com.apple.preference.security?Privacy_Automation'"
        end try
    end if
    try
        display alert "Warden summon failed" message (e & " (error " & n & ")" & hint) as warning giving up after 12
    end try
    return "error " & n & ": " & e & hint
end fail


-- ---------------------------------------------------------------- environment

on isTerminalGuiRunning()
    -- pgrep -x matches the executable name exactly: no LaunchServices, no
    -- automation permission needed.
    set r to (do shell script "if pgrep -x iTerm2 >/dev/null 2>&1 || pgrep -x iTerm >/dev/null 2>&1; then echo yes; else echo no; fi")
    return (r is "yes")
end isTerminalGuiRunning


-- ---------------------------------------------------------------- repo path

on resolveRepo()
    -- Prefer the absolute path baked in at init time (survives the applet being
    -- moved out of the repo).
    if REPO_HINT starts with "/" then
        try
            if (do shell script "[ -d " & quoted form of REPO_HINT & " ] && echo yes") is "yes" then
                return REPO_HINT
            end if
        end try
    end if
    -- Fallback: `path to me` is .../app/Warden.app or
    -- .../app/warden-summon.applescript; both have app as their dirname, so one
    -- level up is the repository root.
    set p to POSIX path of (path to me)
    if p ends with "/" then set p to text 1 thru -2 of p
    set appDir to (do shell script "dirname " & quoted form of p)
    if appDir ends with "/app" then
        return (do shell script "cd " & quoted form of appDir & " && cd .. && pwd")
    end if
    return appDir
end resolveRepo


-- ---------------------------------------------------------------- marker / log

on readMarker(p)
    try
        return (do shell script "cat " & quoted form of p & " 2>/dev/null || true")
    on error
        return ""
    end try
end readMarker

on writeMarker(p, theId)
    if theId is "" then return
    try
        do shell script "printf %s " & quoted form of theId & " > " & quoted form of p
    on error
        -- Can't write the marker? Fine: the next summon just makes a new window.
    end try
end writeMarker

on logLine(msg)
    try
        set p to my resolveRepo() & "/" & LOG_REL
        -- mkdir -p every time: a missing log directory must not hide a failure
        set d to do shell script "dirname " & quoted form of p
        do shell script "mkdir -p " & quoted form of d & " && echo " & quoted form of msg & " >> " & quoted form of p
    end try
end logLine
