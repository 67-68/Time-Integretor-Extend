+
+async function waitForPageContent(page: Page, timeoutMs: number): Promise<boolean> {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    if (!(await isBlankPage(page))) return true;
+    await page.waitForTimeout(500).catch(() => {});
+  }
+  return !(await isBlankPage(page));
