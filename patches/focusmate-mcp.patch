+ *     open '/Users/a67_68/.focusmate-mcp/screenshots/book-session-attempt-0-error-….png'
+ *   Booking attempt 3 failed … book-session-attempt-2-error-….png   ← 最终报给用户的
+ * 也就是说：真正让预定失败的错误（网络/页面）被「写截图失败」顶掉了，
+ * 而且错误类型被换成 AutomationFailedError，连「不可重试」的判断都失效了。
+ */
+
+const createdDirs: string[] = [];
+const envKeys = ['FOCUSMATE_SCREENSHOT_DIR', 'FOCUSMATE_MCP_HOME', 'FOCUSMATE_CONFIG_DIR'];
+const savedEnv: Record<string, string | undefined> = {};
+
+for (const key of envKeys) savedEnv[key] = process.env[key];
+
+function tempDir(name: string): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), `fm-${name}-`));
+  createdDirs.push(dir);
+  return dir;
+}
+
+/** 假装是 Page：只实现 withErrorScreenshot 会用到的 screenshot()。 */
+function fakePage(screenshot: (options: { path?: string }) => Promise<unknown>): Page {
+  return { screenshot } as unknown as Page;
+}
+
+/** 假装是 Page：只实现判断空白页会用到的 evaluate()。 */
+function pageWithText(text: string | (() => never)): Page {
+  return {
+    evaluate: async (fn: () => unknown) => {
+      if (typeof text === 'function') return text();
+      return text.trim().length === 0;
+    }
+  } as unknown as Page;
+}
+
+afterEach(() => {
+  for (const dir of createdDirs.splice(0)) {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+  for (const key of envKeys) {
+    if (savedEnv[key] === undefined) delete process.env[key];
+    else process.env[key] = savedEnv[key];
+  }
+  vi.restoreAllMocks();
+});
+
+describe('withErrorScreenshot', () => {
+  it('returns the operation result untouched when nothing throws', async () => {
+    const page = fakePage(async () => {});
+    const result = await withErrorScreenshot(page, 'op', async () => 42);
+    expect(result).toBe(42);
+  });
+
+  it('does not let a failing screenshot (EPERM) mask the real error', async () => {
+    // 模拟沙箱禁写 ~/.focusmate-mcp/screenshots：写截图必然 EPERM。
+    const page = fakePage(async () => {
+      throw new Error(
+        "EPERM: operation not permitted, open '/Users/x/.focusmate-mcp/screenshots/op-error.png'"
+      );
+    });
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+
+    const realError = new Error('page.goto: net::ERR_TUNNEL_CONNECTION_FAILED');
+    const thrown = await withErrorScreenshot(page, 'book-session-attempt-0', async () => {
+      throw realError;
+    }).catch((error: unknown) => error as Error);
+
+    expect(thrown.message).toContain('ERR_TUNNEL_CONNECTION_FAILED');
+    expect(thrown.message).not.toContain('EPERM');
+    expect(thrown).toBeInstanceOf(AutomationFailedError);
+    expect((thrown as AutomationFailedError).screenshotPath).toBeUndefined();
+  });
+
+  it('rethrows known business errors as-is so retry/errorCode logic still works', async () => {
+    const page = fakePage(async () => {
+      throw new Error('EPERM: operation not permitted');
+    });
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+
+    const conflict = new SlotUnavailableError();
+    const thrown = await withErrorScreenshot(page, 'op', async () => {
+      throw conflict;
+    }).catch((error: unknown) => error);
+
+    // 必须是同一个实例：book-session.ts 靠 instanceof 决定「不重试」。
+    expect(thrown).toBe(conflict);
+    expect(thrown).not.toBeInstanceOf(AutomationFailedError);
+  });
+
+  it('saves the screenshot to FOCUSMATE_SCREENSHOT_DIR and reports the path', async () => {
+    const dir = tempDir('shots');
+    process.env.FOCUSMATE_SCREENSHOT_DIR = dir;
+
+    // Playwright 的 path 选项 = 直接写文件，这里如法炮制。
+    const page = fakePage(async (options) => {
+      if (options.path) fs.writeFileSync(options.path, 'PNG');
+      return Buffer.from('PNG');
+    });
+
+    const thrown = (await withErrorScreenshot(page, 'book-session-attempt-2', async () => {
+      throw new Error('boom');
+    }).catch((error: unknown) => error)) as AutomationFailedError;
+
+    expect(thrown).toBeInstanceOf(AutomationFailedError);
+    expect(thrown.screenshotPath).toBeDefined();
+    expect(fs.realpathSync(path.dirname(thrown.screenshotPath as string))).toBe(fs.realpathSync(dir));
+    expect(thrown.screenshotPath).toContain('book-session-attempt-2-error-');
+    expect(fs.existsSync(thrown.screenshotPath as string)).toBe(true);
+    expect(thrown.message).toContain('boom');
+  });
+
+  it('falls back to another writable directory when the preferred one is unusable', async () => {
+    // 首选目录是个不可能建出来的路径（父级是文件）。
+    const blocker = path.join(tempDir('blocker'), 'not-a-dir');
+    fs.writeFileSync(blocker, '');
+    process.env.FOCUSMATE_SCREENSHOT_DIR = path.join(blocker, 'screenshots');
+
+    const dir = tempDir('fallback');
+    process.env.FOCUSMATE_MCP_HOME = dir;
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+
+    const page = fakePage(async (options) => {
+      if (options.path) fs.writeFileSync(options.path, 'PNG');
+      return Buffer.from('PNG');
+    });
+
+    const thrown = (await withErrorScreenshot(page, 'op', async () => {
+      throw new Error('boom');
+    }).catch((error: unknown) => error)) as AutomationFailedError;
+
+    expect(thrown.screenshotPath).toBeDefined();
+    // 首选目录写不了 → 落到 <FOCUSMATE_MCP_HOME>/screenshots。
+    expect(thrown.screenshotPath).toBe(path.join(dir, 'screenshots', path.basename(thrown.screenshotPath as string)));
+    expect(fs.existsSync(thrown.screenshotPath as string)).toBe(true);
+  });
+});
+
+describe('resolveConfigDir', () => {
+  it('defaults to ~/.focusmate-mcp', () => {
+    delete process.env.FOCUSMATE_MCP_HOME;
+    delete process.env.FOCUSMATE_CONFIG_DIR;
+    expect(resolveConfigDir()).toBe(path.join(os.homedir(), '.focusmate-mcp'));
+  });
+
+  it('honours FOCUSMATE_MCP_HOME and FOCUSMATE_CONFIG_DIR', () => {
+    process.env.FOCUSMATE_MCP_HOME = '/tmp/fm-home';
+    delete process.env.FOCUSMATE_CONFIG_DIR;
+    expect(resolveConfigDir()).toBe('/tmp/fm-home');
+
+    process.env.FOCUSMATE_CONFIG_DIR = '/tmp/fm-config';
+    expect(resolveConfigDir()).toBe('/tmp/fm-config');
+  });
+});
+
+
+describe('isBlankPage', () => {
+  it('detects an unmounted SPA (empty body text)', async () => {
+    await expect(isBlankPage(pageWithText('   '))).resolves.toBe(true);
+  });
+
+  it('treats a rendered page as not blank', async () => {
+    await expect(isBlankPage(pageWithText('Session Settings 25 min 50 min'))).resolves.toBe(false);
+  });
+
+  it('does not blow up on a dead page/context', async () => {
+    const dead = {
+      evaluate: async () => {
+        throw new Error('Target page, context or browser has been closed');
+      }
+    } as unknown as Page;
+    await expect(isBlankPage(dead)).resolves.toBe(false);
+  });
+});
