+/**
+ * 在 booking API 的响应里递归找 session id。
+ * 上游只认 body.sessionId / body.session.sessionId / body.id 三种平铺结构，
+ * 实测真实响应可能是更深或不同的嵌套，所以这里做通用递归：
+ *   1) 任意键名匹配 /session.*id/i 的字符串值
+ *   2) 任意同时含 {id, startTime} 的对象（Focusmate session 的典型形状）
+ */
+function extractSessionIdFromJson(text: string): string | undefined {
+  let body: unknown;
+  try {
+    body = JSON.parse(text);
+  } catch {
+    return undefined;
+  }
+
+  const seen = new Set<unknown>();
+  const looksLikeId = (v: unknown): v is string =>
+    typeof v === 'string' && /^[0-9a-zA-Z_-]{8,}$/.test(v);
+
+  const walk = (node: unknown): string | undefined => {
+    if (!node || typeof node !== 'object' || seen.has(node)) return undefined;
+    seen.add(node);
+
+    if (Array.isArray(node)) {
+      for (const item of node) {
+        const found = walk(item);
+        if (found) return found;
+      }
+      return undefined;
+    }
+
+    const obj = node as Record<string, unknown>;
+
+    // 形状 2: {id, startTime} —— 最可靠的 session 对象特征
+    if (looksLikeId(obj.id) && typeof obj.startTime === 'string') {
+      return obj.id;
+    }
+
+    for (const [k, v] of Object.entries(obj)) {
+      // 形状 1: 键名含 session 且以 id 结尾
+      if (/session.*id$/i.test(k) && looksLikeId(v)) return v;
+    }
+
+    for (const v of Object.values(obj)) {
+      const found = walk(v);
+      if (found) return found;
+    }
+    return undefined;
+  };
+
+  return walk(body);
+}
